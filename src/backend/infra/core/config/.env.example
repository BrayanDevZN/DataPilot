ENVIROIMENT=test

# test:
# - DATABASE_URL vazio => sqlite+aiosqlite:///.../src/backend/repository/db/data.db
# - OPENAI_API_KEY vazia => agents respondem em modo de teste sem request externa
#
# prod:
# - DATABASE_URL, OPENAI_API_KEY e SING são obrigatórias
#
# PostgreSQL assíncrono deve usar explicitamente asyncpg:
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/database
DATABASE_URL=
DB_CONNECT_TIMEOUT=10

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

EMAIL_TIMEOUT=30
URL_EMAIL=
URL_SENDER=http://api:8000

CELERY_BROKER_URL=redis://redis-celery:6379/0
CELERY_BACKEND_URL=redis://redis-celery:6379/0

OPENAI_API_KEY=

SECRET=
SING=
CORS_ALLOWED_ORIGINS=http://localhost:5173

COOKIE_SECURE=false

# Cross-site frontend/backend in production:
# COOKIE_SECURE=true
# COOKIE_SAMESITE=none
COOKIE_SAMESITE=lax
